<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 测试工程与本机试跑用的回显服务就放在工程目录里:别让默认通配把它们的源码
         (以及测试工程的 bin/obj)编进插件。 -->
    <DefaultItemExcludes>$(DefaultItemExcludes);VelaPlugin1.Tests/**;tools/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- 插件工程只需要这一个包:契约程序集、与宿主版本一致的 Avalonia、
         plugin.json 处理、清单校验与 `dotnet build -t:PackVpx` 都随它到位。
         协议插件用不到界面,但 Avalonia 是 compile-only 的,不进插件目录,不占包体。 -->
    <PackageReference Include="VelaShell.PluginSdk.Build" Version="SDK_VERSION" />
  </ItemGroup>

  <ItemGroup>
    <!-- 单测直接驱动内部类型(设置解析、会话)。 -->
    <InternalsVisibleTo Include="VelaPlugin1.Tests" />
  </ItemGroup>

</Project>
